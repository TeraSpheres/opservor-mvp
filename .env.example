# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Integrations only. Both are secrets. ---
#
# Neither may ever be given a NEXT_PUBLIC_ prefix. Next.js inlines anything so
# prefixed into the JavaScript every visitor downloads, and these two would
# hand over every tenant's data and every customer's own systems.

# Supabase service role key (Project Settings > API > service_role).
# Bypasses row-level security completely. Used by one server route and nothing
# else — see src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encrypts stored API credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kept out of the database on purpose, so a copy of the database is inert
# without it. Lose it and every stored credential must be entered again.
INTEGRATION_KEY=generate-32-random-bytes
